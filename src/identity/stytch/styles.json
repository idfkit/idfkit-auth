{
  "fontFamily": "Inter, system-ui, \"-apple-system\", \"Segoe UI\", Roboto, sans-serif",
  "container": {
    "backgroundColor": "#0c1222",
    "borderColor": "#141d35",
    "borderRadius": "16px",
    "width": "400px"
  },
  "colors": {
    "primary": "#e2e8f0",
    "secondary": "#94a3b8",
    "accent": "#3b82f6",
    "success": "#22c55e",
    "warning": "#f59e0b",
    "error": "#ef4444"
  },
  "buttons": {
    "primary": {
      "backgroundColor": "#3b82f6",
      "textColor": "#060a14",
      "borderColor": "#3b82f6",
